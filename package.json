{
  "name": "dsh-ai-passport",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "description": "AI Passport × DeepSeek Harness 联动插件：BLE 联机、任务新建与选择、执行状态显示、完成提醒、任务审批、DeepSeek 余额、语音输入",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "ai-passport",
    "folotoy",
    "esp32",
    "ble",
    "bluetooth",
    "speech-to-text",
    "voice-input"
  ],
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    "./client": "./lib/client.js",
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test \"lib/**/*.test.js\" \"test/**/*.test.js\"",
    "install-plugin": "node tools/install-plugin-to-dsh.mjs",
    "check-env": "./tools/setup-env.sh --check",
    "build:firmware": "./tools/build-firmware.sh",
    "check:static": "cd vendor/ai-passport && ./tools/validate.sh --static"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.5 <0.3.0-0",
      "dshReleases": {
        "0.2.1-rc.5": "compatible"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@stoprocent/noble": "^2.8.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@stoprocent/noble"
    ]
  },
  "author": "slinxiaosun-blip",
  "license": "MIT"
}
